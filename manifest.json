{
  "manifest_version": 3,
  "name": "Quiet Preview for Netflix",
  "version": "1.7.10",
  "description": "Netflixを開いた瞬間の「あの大きな音」にさようなら。プレビューだけを静かにして、本編はいつもの音量で楽しめます。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*"
  ],
  "action": {
    "default_title": "Quiet Preview for Netflix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
