{
  "manifest_version": 3,
  "name": "Netflix プレビュー音量",
  "version": "1.3.8",
  "description": "Netflixのホームと作品詳細で再生されるプレビューの音量だけを調整します。本編の音量には影響しません。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*"
  ],
  "action": {
    "default_title": "Netflix プレビュー音量",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
